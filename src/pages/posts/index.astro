---
export const prerender = true;
import BaseHead from '../../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPosts } from '../../lib/eidos';

const posts = await getPosts();

function formatDate(date: Date | undefined) {
	if (!date || isNaN(date.getTime())) return '';
	return date.toISOString().split('T')[0];
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		</script>
		<style>
			body {
				background: var(--bg);
				color: var(--text);
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 40px 20px;
			}
			.header {
				max-width: 800px;
				margin: 0 auto;
				padding: 30px 20px 0 20px;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.back-link {
				color: var(--text);
				text-decoration: none;
				font-size: 18px;
			}
			.emoji-toggle {
				background: none;
				border: none;
				cursor: pointer;
				padding: 0;
				font-size: 24px;
				line-height: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: transform 0.2s;
				color: var(--text);
			}
			.emoji-toggle:hover {
				transform: scale(1.1);
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			li {
				margin-bottom: 24px;
				display: flex;
				align-items: baseline;
			}
			.date {
				color: #999;
				font-family: monospace;
				width: 120px;
				flex-shrink: 0;
				margin-right: 20px;
				font-size: 1rem;
			}
			.title {
				color: var(--text);
				text-decoration: none;
				font-size: 1.1rem;
				font-weight: 500;
				border-bottom: 1.5px solid var(--text);
				padding-bottom: 1px;
			}
			.title:hover {
				color: var(--gray);
				border-color: var(--gray);
			}
			@media (max-width: 600px) {
				main {
					padding: 30px 16px;
				}
				.header {
					padding: 30px 16px 0 16px;
				}
				li {
					flex-direction: column;
					gap: 4px;
				}
				.date {
					width: auto;
					margin-right: 0;
					font-size: 0.85rem;
				}
				.title {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="header">
			<a href="/" class="back-link">👈back</a>
			<button id="theme-toggle" class="emoji-toggle" aria-label="Toggle theme">
				<span id="theme-emoji">😉</span>
			</button>
		</div>
		<script>
			const themeToggle = document.getElementById('theme-toggle');
			const themeEmoji = document.getElementById('theme-emoji');

			const updateEmoji = (theme: string | null) => {
				if (themeEmoji) {
					themeEmoji.textContent = theme === 'dark' ? '🌙' : '☀️';
				}
			};

			updateEmoji(document.documentElement.getAttribute('data-theme'));

			themeToggle?.addEventListener('click', () => {
				const currentTheme = document.documentElement.getAttribute('data-theme');
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				
				document.documentElement.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
				updateEmoji(newTheme);
			});
		</script>
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<span class="date">{formatDate(post.pubDate)}</span>
								<a href={`/posts/${post.slug}/`} class="title">
									{post.title}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
	</body>
</html>
